<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG ONLY. This file lives in src/debug/ and is not part of a release build.

  Android blocks cleartext HTTP by default for targetSdk 28+, so the debug base URL
  http://10.0.2.2:3001 (the host loopback as seen from an emulator) is refused with
  "CLEARTEXT communication to 10.0.2.2 not permitted by network security policy" before a socket is
  opened. That failure surfaces as a generic network error, which is indistinguishable from the
  server being down.

  The exemption is scoped to the single loopback address and does NOT include subdomains, so it
  cannot silently widen. cleartextTrafficPermitted stays false everywhere else, including for
  resumemaster.one, and the release build has no override at all.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>

<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup and transfer excludes for API 31+ (android:dataExtractionRules).

  Two independent channels, and an exclude in one does NOT imply the other:
    cloud-backup    is Google cloud backup, off device.
    device-transfer is direct device to device migration.

  The bearer token is excluded from BOTH. Off device is the obvious case. Device transfer matters
  for a different reason: the Keystore key wrapping "rm_secure_prefs" cannot migrate, so a
  transferred file is undecryptable ciphertext that would present as a corrupt token sign in
  failure rather than as a clean "please sign in".
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="rm_secure_prefs.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="rm_secure_prefs.xml"/>
    </device-transfer>
</data-extraction-rules>

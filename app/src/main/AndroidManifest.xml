<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <application android:name=".ResumeMasterApp" android:allowBackup="true" android:dataExtractionRules="@xml/data_extraction_rules" android:fullBackupContent="@xml/backup_rules" android:icon="@mipmap/ic_launcher" android:label="@string/app_name" android:roundIcon="@mipmap/ic_launcher_round" android:supportsRtl="true" android:theme="@style/Theme.ResumeMaster">
        <provider android:name="androidx.core.content.FileProvider" android:authorities="${applicationId}.fileprovider" android:exported="false" android:grantUriPermissions="true"><meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" /></provider>
        <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTop" android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
                THIS HOST IS A PLACEHOLDER AND THE FIX IS SERVER-SIDE, NOT HERE.

                YOUR_DOMAIN.com is a template value the project does not own, so App Links
                verification fails and this filter never claims the callback. The obvious repair is
                to write jobsviadraft.com, and it would not work either: Android verifies an
                autoVerify filter by fetching https://<host>/.well-known/assetlinks.json and
                requires real JSON naming this applicationId and the signing certificate's SHA-256.
                That path currently answers HTTP 200 with the web app's index.html, because the SPA
                has a catch-all route — the same catch-all that has already "confirmed" a
                deployment which had not happened. It was probed by reading the body, not the
                status code.

                So the order is: serve assetlinks.json for jobsviadraft.com with this app's release
                fingerprint, THEN set the host here, THEN verify with
                `adb shell pm get-app-links com.draft.android`. Setting the host first only
                moves the failure somewhere harder to see.

                NOTE the applicationId in that command is com.draft.android, which is what
                assetlinks.json must name too — not the Kotlin package, which is still
                com.resumemaster.android and is not what Android checks.

                Nothing depends on this filter today: LinkedInAuthManager.startImport opens a
                Custom Tab and the callback is delivered to the same task, so the import path does
                not need the deep link to be verified.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="YOUR_DOMAIN.com" android:pathPrefix="/auth/linkedin/callback" />
            </intent-filter>
        </activity>
    </application>
</manifest>
